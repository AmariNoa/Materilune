.materilune-swap-entry {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.materilune-swap-entry > .unity-object-field {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 1px;
    margin-right: 1px;
}

/* The destination field and the inherited value share one cell. The label is taken out of
   the flow and laid over the field, so showing or hiding it never moves anything. */
.materilune-swap-entry__to-slot {
    flex-grow: 1;
    flex-basis: 0;
}

.materilune-swap-entry__to-slot > .unity-object-field {
    margin-left: 1px;
    margin-right: 1px;
}

/* The field prints "None (Material)" of its own accord when it holds nothing, so the label
   is opaque and sits over that text rather than beside it. The inset leaves the field's
   border and its picker button uncovered, so the row still looks and behaves like a field.
   The background follows the editor theme's own field colour, so it matches in both themes. */
.materilune-swap-entry__inherited {
    position: absolute;
    left: 1px;
    right: 19px;
    top: 1px;
    bottom: 1px;
    flex-direction: row;
    align-items: center;
    padding-left: 2px;
    overflow: hidden;
    background-color: var(--unity-colors-input_field-background);

    /* The field's own corners are rounded, so the cover has to be as well or the row looks
       like a field with a square patch stuck on its left end. Only the left corners are
       rounded: the right edge of the cover sits inside the field, not at its border. */
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

/* A drawn bar rather than an icon. Built-in editor icons come at whatever size the running
   editor ships them at, which is not something this package can pin down, and a mismatch
   between that size and the box shows up as a clipped icon. A bar has no texture to fit. */
.materilune-swap-entry__inherited-mark {
    width: 3px;
    align-self: stretch;
    flex-shrink: 0;
    margin-right: 4px;
    background-color: rgb(90, 150, 210);
}

.materilune-swap-entry__inherited-text {
    flex-grow: 1;
    -unity-text-align: middle-left;
    overflow: hidden;
    color: rgba(210, 210, 210, 0.5);
    -unity-font-style: italic;
}

.materilune-swap-entry > .unity-button {
    width: 58px;
    min-width: 58px;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 0;
    padding-right: 0;
}


/* A row whose source material is no longer offered by the target meshes. The replacement is
   kept so it survives the material coming back, but it is not applied, so the row is marked
   rather than removed. Only the colour changes, which keeps the layout still. */
.materilune-swap-entry--orphaned {
    background-color: rgb(96, 82, 48);
}
