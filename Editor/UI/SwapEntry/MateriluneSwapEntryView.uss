.materilune-swap-entry {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.materilune-swap-entry > .unity-object-field {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 1px;
    margin-right: 1px;
}

.materilune-swap-entry > .unity-button {
    width: 58px;
    min-width: 58px;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 0;
    padding-right: 0;
}


/* A row whose source material is no longer offered by the target meshes. The replacement is
   kept so it survives the material coming back, but it is not applied, so the row is marked
   rather than removed. Only the colour changes, which keeps the layout still. */
.materilune-swap-entry--orphaned {
    background-color: rgb(96, 82, 48);
}
