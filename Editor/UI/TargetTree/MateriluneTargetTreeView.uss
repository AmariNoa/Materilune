.materilune-target-tree {
    flex-grow: 1;
    min-height: 0;
}

.materilune-target-tree__row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.materilune-target-tree__row--selectable {
    flex-grow: 1;
}

.materilune-target-tree__row--selected {
    -unity-font-style: bold;
    background-color: rgba(128, 128, 128, 0.18);
}

.materilune-target-tree__row--inactive {
    opacity: 0.55;
}
