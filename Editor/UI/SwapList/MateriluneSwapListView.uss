.materilune-swap-list {
    flex-direction: column;
}

#entries {
    flex-direction: column;
}

.materilune-swap-list__row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.materilune-swap-list__row > .materilune-swap-entry {
    flex-grow: 1;
}

.materilune-swap-list__row > .unity-button {
    width: 20px;
    min-width: 20px;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 0;
    padding-right: 0;
}

.materilune-swap-list__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 2px;
}

.materilune-swap-list__footer > .unity-button {
    width: 24px;
    min-width: 24px;
    padding-left: 0;
    padding-right: 0;
}
