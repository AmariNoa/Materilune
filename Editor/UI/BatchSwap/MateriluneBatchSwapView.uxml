        <ui:VisualElement style="flex-shrink: 0; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Button name="btn-cancel" class="materilune-batch-swap__action" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Button name="btn-apply" class="materilune-batch-swap__action" />
