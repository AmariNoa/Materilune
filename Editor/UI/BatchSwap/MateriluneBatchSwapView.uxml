<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.amari-noa.materilune/Editor/UI/BatchSwap/MateriluneBatchSwapView.uss?fileID=7433441132597879392&amp;guid=b476d287f4d91b7e32fd1bf6219206b6&amp;type=3#MateriluneBatchSwapView" />
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
            <ui:Label name="lbl-step" class="materilune-batch-swap__step" />
            <ui:VisualElement name="elm-footer" class="materilune-batch-swap__footer">
                <ui:VisualElement style="flex-grow: 1;">
