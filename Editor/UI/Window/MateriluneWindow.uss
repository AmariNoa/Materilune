/* Sizes are expressed as percentages of the window so the layout keeps its proportions
   at any window size. Percentages resolve against the parent's width, including the
   vertical ones, so vertical gaps are left to the boxes' own borders instead. */

.materilune-window {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.materilune-window__toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.materilune-window__toolbar #target-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.materilune-window__toolbar #lock-toggle {
    flex-shrink: 0;
    margin-left: 0.5%;
    margin-right: 0.5%;
}

.materilune-window__toolbar #language-slot {
    flex-shrink: 0;
}

.materilune-window__setup {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.materilune-window__setup #setup-message {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.materilune-window__setup #setup-button {
    flex-shrink: 0;
    margin-left: 0.5%;
}

#content-container {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.materilune-window__pane {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    margin-right: 0.5%;
}

.materilune-window__preset-pane {
    flex-basis: 15%;
    flex-grow: 15;
}

.materilune-window__root-pane {
    flex-basis: 32%;
    flex-grow: 32;
}

.materilune-window__override-pane {
    flex-basis: 38%;
    flex-grow: 38;
}

.materilune-window__tree-pane {
    flex-basis: 15%;
    flex-grow: 15;
    margin-right: 0;
}

.materilune-window__pane-header {
    -unity-font-style: bold;
    flex-shrink: 0;
}

.materilune-window__pane-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.materilune-window__pane-body > .unity-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

#preset-slot,
#root-slot,
#override-slot,
#tree-slot {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* The preset bar ships as a horizontal strip. The window stacks it instead, without
   touching the part itself, so the same part stays reusable elsewhere. */
.materilune-window__preset-pane .materilune-preset-bar {
    flex-direction: column;
    align-items: stretch;
}

.materilune-window__preset-pane .materilune-preset-bar #presets {
    flex-direction: column;
    flex-wrap: nowrap;
    flex-grow: 0;
    align-items: stretch;
}

.materilune-window__preset-pane .materilune-preset-bar #presets > .unity-button {
    width: auto;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    align-self: stretch;
}

.materilune-window__preset-pane .materilune-preset-bar #add-button {
    width: auto;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    align-self: stretch;
}

#empty-message {
    flex-shrink: 0;
    white-space: normal;
}
